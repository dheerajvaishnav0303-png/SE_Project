# Server Configuration
PORT=5000
NODE_ENV=development

# Database Topology (MongoDB 8.0 Replica Set required for ACID transactions)
MONGO_URI=mongodb://localhost:27017/ips_wealth?replicaSet=rs0

# In-Memory Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets (Minimum 32 characters for HMAC SHA-256)
JWT_ACCESS_SECRET=dev_jwt_access_secret_institutional_grade_32chars_min!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_institutional_grade_32chars_min!

# Field-Level Encryption Key (Strictly 64 hex characters = 32 bytes for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Network & CORS Security
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=900000

